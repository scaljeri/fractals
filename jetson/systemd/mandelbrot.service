# Template for the Mandelbrot render service systemd unit.
#
# build.sh substitutes the @…@ placeholders with values from .env and writes
# the result to build/systemd/mandelbrot.service. Install on the Jetson with:
#
#   sudo cp systemd/mandelbrot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mandelbrot
#
[Unit]
Description=Mandelbrot render service (CUDA + NVENC)
After=network.target

[Service]
Type=simple
User=@JETSON_USER@
WorkingDirectory=@JETSON_DIR@
Environment=PORT=@JETSON_PORT@
# pycuda runtime-compiles kernels via nvcc — systemd's stripped PATH doesn't
# include /usr/local/cuda/bin, so jobs fail with "No such file or directory: 'nvcc'"
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash @JETSON_DIR@/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
