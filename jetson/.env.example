# Copy this to .env and fill in your Jetson details.
# The .env file itself is gitignored; only .env.example is committed.

# SSH connection to the Jetson
JETSON_USER=luca
JETSON_HOST=192.168.1.100

# Where on the Jetson the deployment bundle lives
JETSON_DIR=~/mandelbrot/jetson

# Port the render service listens on (must match what you put in the browser)
JETSON_PORT=8080
