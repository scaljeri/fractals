# Copy this to .env and fill in your deploy target. The .env file is
# gitignored; only .env.example is committed.

# SSH user + host for the static web server.
DEPLOY_USER=you
DEPLOY_HOST=example.com

# Absolute remote path that index.html should land in.
DEPLOY_DIR=/var/www/mandelbrot

# Optional rsync flags (e.g. --dry-run for a sanity check first).
# RSYNC_FLAGS="--dry-run"
