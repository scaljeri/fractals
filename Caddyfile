# Single-container Caddy config for local docker-compose dev.
# Serves static frontend from /srv and reverse-proxies /gpu/* to the Jetson
# render service (configured via the JETSON_URL env var).

:80 {
    # Static frontend (index.html, main.js, …)
    handle / {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    handle /* {
        root * /srv
        file_server
    }

    # Reverse-proxy to the Jetson render service. JETSON_URL is evaluated at
    # container start; change it with `JETSON_URL=... docker compose up`.
    handle_path /gpu/* {
        reverse_proxy {$JETSON_URL:http://host.docker.internal:8080} {
            transport http {
                read_timeout 1h
                write_timeout 1h
            }
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    encode gzip
    log {
        output stdout
        format console
    }
}
